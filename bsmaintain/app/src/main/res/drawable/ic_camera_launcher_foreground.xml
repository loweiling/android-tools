<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底層：原本的 bsmaintain 圖示 -->
    <item android:drawable="@mipmap/ic_launcher_foreground" />

    <!-- 右下角小相機 badge -->
    <item
        android:width="26dp"
        android:height="26dp"
        android:gravity="bottom|end"
        android:bottom="18dp"
        android:right="18dp">
        <layer-list>
            <!-- 白色圓底 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
            <!-- 藍色圓框 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FF1A73E8" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
            <!-- 相機圖示（縮小置中） -->
            <item
                android:drawable="@drawable/ic_camera_badge"
                android:top="5dp"
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp" />
        </layer-list>
    </item>
</layer-list>
